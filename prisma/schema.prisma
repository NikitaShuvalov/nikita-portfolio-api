generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  github      String?
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  level     String?
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

model Experience {
  id           Int      @id @default(autoincrement())
  company      String
  position     String
  startDate    String
  endDate      String?
  achievements String
  profileId    Int
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  url         String?
  profileId   Int
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
